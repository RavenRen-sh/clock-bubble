{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clock-bubble",
  "version": "0.1.0",
  "identifier": "com.local.clock-bubble",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Clock Bubble",
        "width": 224,
        "height": 176,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  }
}
